<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>💖 可爱表白 · 同意后固定 💖</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Quicksand', 'Segoe UI', 'Comic Sans MS', 'Chalkboard SE', cursive, sans-serif;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(145deg, #ffe9f4 0%, #ffd9e8 100%);
            padding: 12px;
            position: relative;
            overflow: hidden;
            transition: background 0.5s ease;
        }

        /* 固定状态 - 背景保持不变 */
        body.fixed {
            background: linear-gradient(145deg, #ffe0ec, #ffc8dd);
        }

        /* 可爱漂浮装饰 */
        .floating-hearts {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
            transition: opacity 0.8s ease;
        }

        /* 固定后漂浮装饰淡出 */
        .floating-hearts.fixed {
            opacity: 0.2;
        }

        .heart-float {
            position: absolute;
            font-size: 1.6rem;
            opacity: 0.15;
            animation: floatUp 12s infinite alternate ease-in-out;
            transform-origin: center;
        }

        .heart-float:nth-child(1) { left: 3%; animation-duration: 14s; font-size: 2.2rem; }
        .heart-float:nth-child(2) { left: 18%; animation-duration: 16s; font-size: 1.8rem; animation-delay: -2s; }
        .heart-float:nth-child(3) { left: 38%; animation-duration: 13s; font-size: 2.8rem; animation-delay: -4s; }
        .heart-float:nth-child(4) { left: 58%; animation-duration: 18s; font-size: 2rem; animation-delay: -1s; }
        .heart-float:nth-child(5) { left: 78%; animation-duration: 15s; font-size: 2.4rem; animation-delay: -6s; }
        .heart-float:nth-child(6) { left: 92%; animation-duration: 17s; font-size: 1.6rem; animation-delay: -3s; }
        .heart-float:nth-child(7) { left: 48%; animation-duration: 19s; font-size: 2rem; animation-delay: -8s; opacity: 0.08; }

        @keyframes floatUp {
            0% { transform: translateY(10vh) rotate(0deg) scale(1); }
            100% { transform: translateY(-30vh) rotate(20deg) scale(1.2); }
        }

        /* 主卡片 */
        .love-card {
            position: relative;
            z-index: 10;
            background: rgba(255, 245, 248, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 40px;
            box-shadow: 0 16px 48px rgba(255, 100, 150, 0.2),
                        0 6px 16px rgba(255, 80, 130, 0.12),
                        inset 0 0 0 2px rgba(255, 255, 255, 0.5);
            padding: 28px 20px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            transition: 0.25s ease;
            border: 2px solid rgba(255, 200, 220, 0.4);
        }

        /* 固定后卡片样式微调 */
        .love-card.fixed {
            box-shadow: 0 20px 60px rgba(255, 80, 130, 0.3),
                        0 8px 20px rgba(255, 80, 130, 0.15),
                        inset 0 0 0 2px rgba(255, 255, 255, 0.6);
            border-color: rgba(255, 150, 180, 0.6);
        }

        .title-section {
            margin-bottom: 8px;
        }

        .big-emoji {
            font-size: 3.6rem;
            line-height: 1.2;
            filter: drop-shadow(0 6px 10px rgba(255, 80, 130, 0.25));
            display: inline-block;
            animation: pulse 2s infinite;
        }

        /* 固定后大表情停止动画 */
        .love-card.fixed .big-emoji {
            animation: none;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #a6406b;
            text-shadow: 0 3px 10px rgba(255, 120, 170, 0.25);
            letter-spacing: 0.5px;
            margin: 4px 0 2px;
            word-break: break-word;
            transition: color 0.5s ease;
        }

        /* 固定后标题颜色加深 */
        .love-card.fixed h1 {
            color: #8a2a4a;
        }

        .sub-message {
            font-size: 1rem;
            background: rgba(255, 220, 235, 0.5);
            padding: 8px 16px;
            border-radius: 40px;
            display: inline-block;
            backdrop-filter: blur(4px);
            color: #7f3f5a;
            font-weight: 600;
            margin: 4px auto 12px;
            border: 1px solid rgba(255, 180, 200, 0.5);
            box-shadow: 0 2px 6px rgba(255, 130, 170, 0.1);
            transition: all 0.5s ease;
        }

        /* 固定后副消息变化 */
        .love-card.fixed .sub-message {
            background: rgba(255, 200, 220, 0.7);
            color: #6a2a4a;
            border-color: rgba(255, 150, 180, 0.7);
        }

        .message-box {
            background: rgba(255, 255, 255, 0.5);
            border-radius: 32px;
            padding: 14px 16px;
            margin: 12px 0 18px;
            border: 1px solid rgba(255, 180, 200, 0.35);
            backdrop-filter: blur(4px);
            box-shadow: inset 0 2px 6px rgba(255, 200, 220, 0.2);
            transition: all 0.5s ease;
        }

        .love-card.fixed .message-box {
            background: rgba(255, 240, 245, 0.7);
            border-color: rgba(255, 150, 180, 0.5);
        }

        .message-box p {
            font-size: 1.15rem;
            font-weight: 500;
            color: #4d2b3a;
            line-height: 1.5;
            margin: 0;
        }

        .message-box .highlight {
            background: linear-gradient(135deg, #ff9eb5, #ff7ca8);
            padding: 0 10px;
            border-radius: 30px;
            color: white;
            display: inline-block;
            box-shadow: 0 3px 6px rgba(255, 80, 130, 0.2);
            font-size: 1rem;
        }

        /* 按钮区域 */
        .button-group {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin: 12px 0 6px;
            position: relative;
            min-height: 100px;
            padding: 4px;
            transition: all 0.5s ease;
        }

        /* 固定后按钮组高度调整 */
        .love-card.fixed .button-group {
            min-height: 60px;
            gap: 0;
        }

        .btn {
            border: none;
            background: white;
            padding: 14px 28px;
            border-radius: 60px;
            font-size: 1.4rem;
            font-weight: 700;
            color: #4d2b3a;
            cursor: pointer;
            box-shadow: 0 8px 0 #d48aa0, 0 6px 16px rgba(255, 80, 130, 0.2);
            transition: all 0.08s ease-in;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            letter-spacing: 1px;
            border: 2px solid rgba(255, 255, 255, 0.7);
            flex: 0 1 auto;
            min-width: 100px;
            transform: translateY(0);
            position: relative;
            touch-action: manipulation;
            -webkit-touch-callout: none;
        }

        .btn:active {
            transform: translateY(5px);
            box-shadow: 0 3px 0 #b06f86;
        }

        /* 同意按钮 */
        .btn-yes {
            background: linear-gradient(145deg, #ffb3c6, #ff8eb0);
            color: white;
            text-shadow: 0 2px 4px rgba(150, 30, 60, 0.25);
            box-shadow: 0 8px 0 #a6486a, 0 6px 16px rgba(255, 80, 130, 0.3);
            border-color: #ffb0c9;
            font-size: 1.3rem;
            padding: 14px 24px;
            min-width: 90px;
            transition: all 0.4s ease;
        }

        /* 固定后同意按钮变为最终状态 */
        .love-card.fixed .btn-yes {
            background: linear-gradient(145deg, #ffd1b5, #ffb08c);
            box-shadow: 0 6px 0 #b06f5a, 0 6px 20px rgba(255, 120, 80, 0.3);
            transform: scale(1);
            cursor: default;
            pointer-events: none;
            min-width: 140px;
            padding: 14px 32px;
        }

        .btn-yes:hover {
            background: linear-gradient(145deg, #ffbdd0, #ff97b9);
            transform: scale(1.02);
        }

        .btn-yes:active {
            transform: translateY(5px) scale(0.98);
            box-shadow: 0 3px 0 #a6486a;
        }

        /* 不同意按钮 */
        .btn-no {
            background: #f2e3e8;
            color: #5a3f4b;
            box-shadow: 0 8px 0 #b28b9b, 0 6px 16px rgba(120, 70, 90, 0.15);
            border-color: #f0dae2;
            position: absolute;
            left: 0;
            top: 0;
            margin: 0;
            transition: left 0.06s cubic-bezier(0.1, 0.8, 0.3, 1), top 0.06s cubic-bezier(0.1, 0.8, 0.3, 1), opacity 0.5s ease, transform 0.5s ease;
            z-index: 20;
            touch-action: none;
            will-change: left, top;
            min-width: 90px;
            padding: 12px 18px;
            font-size: 1.2rem;
            border-radius: 50px;
        }

        .btn-no:hover {
            background: #f5e6ec;
            transform: scale(0.96);
        }

        .btn-no:active {
            transform: translateY(5px);
            box-shadow: 0 3px 0 #b28b9b;
        }

        /* 不同意按钮消失状态 */
        .btn-no.hidden {
            opacity: 0;
            transform: scale(0.4) rotate(20deg);
            pointer-events: none;
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        /* 小提示 */
        .hint-text {
            margin-top: 18px;
            font-size: 0.85rem;
            color: #a7667f;
            background: rgba(255, 230, 240, 0.5);
            padding: 6px 14px;
            border-radius: 30px;
            display: inline-block;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 180, 200, 0.3);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        .hint-text.hidden {
            opacity: 0;
            transform: translateY(8px);
            pointer-events: none;
        }

        .hint-text span {
            display: inline-block;
            animation: wiggle 2s infinite;
        }

        /* 固定后提示完全隐藏 */
        .love-card.fixed .hint-text {
            opacity: 0;
            transform: translateY(10px);
            pointer-events: none;
        }

        @keyframes wiggle {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(6deg); }
            75% { transform: rotate(-6deg); }
        }

        /* 点击同意后的效果 */
        .celebrate {
            animation: celebration 0.6s ease;
        }

        @keyframes celebration {
            0% { transform: scale(1); }
            20% { transform: scale(1.04) rotate(-1.5deg); }
            40% { transform: scale(1.08) rotate(1.5deg); }
            60% { transform: scale(1.04) rotate(-0.5deg); }
            80% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }

        /* 成功消息 - 最终固定显示 */
        .success-message {
            display: none;
            margin-top: 14px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #a6406b;
            background: rgba(255, 220, 235, 0.6);
            padding: 10px 18px;
            border-radius: 40px;
            backdrop-filter: blur(4px);
            border: 2px solid rgba(255, 180, 200, 0.5);
            animation: pulse 1.5s infinite;
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .success-message.show {
            display: inline-block;
            opacity: 1;
            transform: scale(1);
        }

        /* 固定后成功消息保持显示 */
        .love-card.fixed .success-message {
            animation: pulse 1.5s infinite;
        }

        /* 手机适配 */
        @media (max-width: 380px) {
            .love-card {
                padding: 20px 14px;
                border-radius: 32px;
            }
            .big-emoji {
                font-size: 2.8rem;
            }
            h1 {
                font-size: 1.6rem;
            }
            .btn {
                font-size: 1.1rem;
                padding: 10px 16px;
                min-width: 72px;
            }
            .btn-yes {
                font-size: 1.1rem;
                padding: 10px 16px;
                min-width: 72px;
            }
            .btn-no {
                font-size: 1rem;
                padding: 10px 14px;
                min-width: 72px;
            }
            .message-box p {
                font-size: 1rem;
            }
            .message-box .highlight {
                font-size: 0.9rem;
            }
            .button-group {
                min-height: 80px;
                gap: 12px;
            }
            .love-card.fixed .button-group {
                min-height: 50px;
            }
            .love-card.fixed .btn-yes {
                min-width: 110px;
                padding: 10px 20px;
                font-size: 1rem;
            }
            .success-message {
                font-size: 1rem;
                padding: 8px 14px;
            }
            .sub-message {
                font-size: 0.85rem;
                padding: 6px 12px;
            }
            .hint-text {
                font-size: 0.75rem;
                padding: 4px 10px;
            }
        }

        @media (max-width: 420px) and (min-width: 381px) {
            .love-card {
                padding: 24px 16px;
                border-radius: 36px;
            }
            .big-emoji {
                font-size: 3.2rem;
            }
            h1 {
                font-size: 1.8rem;
            }
            .btn {
                font-size: 1.2rem;
                padding: 12px 20px;
                min-width: 82px;
            }
            .btn-yes {
                font-size: 1.2rem;
                padding: 12px 20px;
                min-width: 82px;
            }
            .btn-no {
                font-size: 1.1rem;
                padding: 10px 16px;
                min-width: 80px;
            }
            .button-group {
                min-height: 90px;
                gap: 14px;
            }
            .love-card.fixed .button-group {
                min-height: 55px;
            }
            .love-card.fixed .btn-yes {
                min-width: 120px;
                padding: 12px 22px;
                font-size: 1.1rem;
            }
            .message-box p {
                font-size: 1.05rem;
            }
        }

        @media (min-width: 421px) {
            .love-card {
                padding: 32px 28px;
                border-radius: 44px;
            }
            .big-emoji {
                font-size: 4.2rem;
            }
            h1 {
                font-size: 2.2rem;
            }
            .btn {
                font-size: 1.5rem;
                padding: 14px 32px;
                min-width: 110px;
            }
            .btn-yes {
                font-size: 1.4rem;
                padding: 14px 28px;
                min-width: 100px;
            }
            .btn-no {
                font-size: 1.3rem;
                padding: 12px 22px;
                min-width: 100px;
            }
            .button-group {
                min-height: 110px;
                gap: 20px;
            }
            .love-card.fixed .button-group {
                min-height: 65px;
            }
            .love-card.fixed .btn-yes {
                min-width: 150px;
                padding: 14px 32px;
                font-size: 1.3rem;
            }
            .message-box p {
                font-size: 1.25rem;
            }
            .success-message {
                font-size: 1.4rem;
                padding: 12px 22px;
            }
        }

        @media (min-width: 768px) {
            .love-card {
                max-width: 480px;
                padding: 40px 36px;
                border-radius: 52px;
            }
            .big-emoji {
                font-size: 4.8rem;
            }
            h1 {
                font-size: 2.6rem;
            }
            .btn {
                font-size: 1.7rem;
                padding: 16px 38px;
                min-width: 130px;
            }
            .btn-yes {
                font-size: 1.6rem;
                padding: 16px 34px;
                min-width: 120px;
            }
            .btn-no {
                font-size: 1.5rem;
                padding: 14px 28px;
                min-width: 120px;
            }
            .button-group {
                min-height: 120px;
                gap: 28px;
            }
            .love-card.fixed .button-group {
                min-height: 70px;
            }
            .love-card.fixed .btn-yes {
                min-width: 170px;
                padding: 16px 38px;
                font-size: 1.5rem;
            }
            .message-box p {
                font-size: 1.4rem;
            }
            .success-message {
                font-size: 1.6rem;
                padding: 14px 28px;
            }
        }

        /* 可爱爪印 */
        .paw {
            position: fixed;
            bottom: 12px;
            right: 12px;
            opacity: 0.15;
            font-size: 2rem;
            transform: rotate(10deg);
            z-index: 0;
            pointer-events: none;
            transition: opacity 0.8s ease;
        }

        .paw-left {
            left: 12px;
            right: auto;
            transform: rotate(-10deg);
        }

        /* 固定后爪印淡出 */
        body.fixed .paw {
            opacity: 0.05;
        }

        @media (max-width: 380px) {
            .paw {
                font-size: 1.4rem;
                bottom: 8px;
                right: 8px;
            }
            .paw-left {
                left: 8px;
            }
        }
    </style>
</head>
<body>
    <!-- 浮动爱心装饰 -->
    <div class="floating-hearts" id="floatingHearts">
        <span class="heart-float">❤️</span>
        <span class="heart-float">🌸</span>
        <span class="heart-float">💕</span>
        <span class="heart-float">✨</span>
        <span class="heart-float">💖</span>
        <span class="heart-float">🦋</span>
        <span class="heart-float">💗</span>
    </div>

    <!-- 小爪印装饰 -->
    <div class="paw">🐾</div>
    <div class="paw paw-left">🐾</div>

    <!-- 主卡片 -->
    <div class="love-card" id="loveCard">
        <div class="title-section">
            <span class="big-emoji">💌</span>
            <h1>我喜欢你！</h1>
        </div>
        <div class="sub-message">
            💘 我对你有很多的好感 💘
        </div>

        <div class="message-box">
            <p>
                <span class="highlight">❤️ 我最中意的人 ❤️</span> <br>
                🌷 你愿意和我试试吗？ 🌷
            </p>
        </div>

        <!-- 按钮组 -->
        <div class="button-group" id="buttonGroup">
            <button class="btn btn-yes" id="yesBtn">💖 同意 💖</button>
            <button class="btn btn-no" id="noBtn">😤 不同意</button>
        </div>

        <div class="hint-text" id="hintText">
            <span>✨ 点“不同意”？它跑得比闪电还快！ ✨</span>
        </div>

        <!-- 成功后显示的消息 -->
        <div class="success-message" id="successMessage">
            🥰 你答应啦！谢谢你！ 💕
        </div>
    </div>

    <script>
        (function() {
            const noBtn = document.getElementById('noBtn');
            const yesBtn = document.getElementById('yesBtn');
            const loveCard = document.getElementById('loveCard');
            const buttonGroup = document.getElementById('buttonGroup');
            const hintText = document.getElementById('hintText');
            const successMessage = document.getElementById('successMessage');
            const floatingHearts = document.getElementById('floatingHearts');
            const body = document.body;

            let isAccepted = false;

            // 初始化按钮为绝对定位
            function initNoButton() {
                const groupRect = buttonGroup.getBoundingClientRect();
                const btnRect = noBtn.getBoundingClientRect();
                const left = btnRect.left - groupRect.left;
                const top = btnRect.top - groupRect.top;
                noBtn.style.position = 'absolute';
                noBtn.style.left = Math.max(0, left) + 'px';
                noBtn.style.top = Math.max(0, top) + 'px';
                noBtn.style.margin = '0';
                buttonGroup.style.minHeight = Math.max(buttonGroup.offsetHeight, 100) + 'px';
            }

            // 获取按钮可用移动范围
            function getMoveBounds() {
                const groupRect = buttonGroup.getBoundingClientRect();
                const btnRect = noBtn.getBoundingClientRect();
                const padding = 4;
                const maxX = Math.max(0, groupRect.width - btnRect.width - padding * 2);
                const maxY = Math.max(0, groupRect.height - btnRect.height - padding * 2);
                return { maxX, maxY };
            }

            // 快速随机移动
            function moveNoButtonFast() {
                if (isAccepted) return;
                const { maxX, maxY } = getMoveBounds();
                if (maxX <= 0 || maxY <= 0) {
                    const currentLeft = parseFloat(noBtn.style.left) || 0;
                    const currentTop = parseFloat(noBtn.style.top) || 0;
                    noBtn.style.left = Math.max(0, currentLeft + (Math.random() - 0.5) * 16) + 'px';
                    noBtn.style.top = Math.max(0, currentTop + (Math.random() - 0.5) * 16) + 'px';
                    return;
                }

                let newLeft = Math.random() * maxX;
                let newTop = Math.random() * maxY;

                newLeft = Math.min(maxX, Math.max(0, newLeft));
                newTop = Math.min(maxY, Math.max(0, newTop));

                noBtn.style.left = newLeft + 'px';
                noBtn.style.top = newTop + 'px';
            }

            function moveNoButtonTwice() {
                if (isAccepted) return;
                moveNoButtonFast();
                setTimeout(() => moveNoButtonFast(), 12);
                setTimeout(() => moveNoButtonFast(), 28);
            }

            // 处理不同意按钮交互
            function handleNoBtnInteraction(e) {
                if (isAccepted) return;
                e.preventDefault();
                e.stopPropagation();
                moveNoButtonTwice();
                setTimeout(() => moveNoButtonFast(), 50);
                noBtn.style.transform = 'scale(0.85)';
                setTimeout(() => noBtn.style.transform = 'scale(1)', 100);
            }

            // 绑定不同意按钮事件
            noBtn.addEventListener('mousedown', handleNoBtnInteraction);
            noBtn.addEventListener('mouseenter', function(e) {
                if (!isAccepted) moveNoButtonTwice();
            });
            noBtn.addEventListener('click', function(e) {
                if (isAccepted) return;
                e.preventDefault();
                e.stopPropagation();
                moveNoButtonTwice();
            });

            noBtn.addEventListener('touchstart', function(e) {
                if (isAccepted) return;
                e.preventDefault();
                e.stopPropagation();
                moveNoButtonTwice();
            }, { passive: false });
            noBtn.addEventListener('touchmove', function(e) {
                if (isAccepted) return;
                e.preventDefault();
                e.stopPropagation();
                moveNoButtonTwice();
            }, { passive: false });

            // 悬停定时器
            let hoverTimer = null;
            noBtn.addEventListener('mouseover', function() {
                if (isAccepted) return;
                if (hoverTimer) clearInterval(hoverTimer);
                hoverTimer = setInterval(() => {
                    if (!isAccepted) moveNoButtonFast();
                }, 80);
            });
            noBtn.addEventListener('mouseout', function() {
                if (hoverTimer) {
                    clearInterval(hoverTimer);
                    hoverTimer = null;
                }
            });

            // 固定页面 - 同意后调用
            function fixPage() {
                isAccepted = true;

                // 添加固定类到 body 和卡片
                body.classList.add('fixed');
                loveCard.classList.add('fixed');
                floatingHearts.classList.add('fixed');

                // 隐藏不同意按钮
                noBtn.classList.add('hidden');
                // 隐藏提示文字（通过卡片固定类已经隐藏，但保留双重保险）
                hintText.classList.add('hidden');

                // 显示成功消息（带动画）
                successMessage.classList.add('show');

                // 移除按钮的绝对定位，让布局稳定
                noBtn.style.position = 'relative';
                noBtn.style.left = 'auto';
                noBtn.style.top = 'auto';
                noBtn.style.transform = 'scale(0)';
                noBtn.style.opacity = '0';
                noBtn.style.pointerEvents = 'none';

                // 调整按钮组，让同意按钮居中
                buttonGroup.style.justifyContent = 'center';
                buttonGroup.style.minHeight = 'auto';
                buttonGroup.style.gap = '0';

                // 同意按钮变为最终状态（已通过CSS处理）
                // 但我们需要确保按钮可点击状态移除
                yesBtn.style.pointerEvents = 'none';

                // 卡片庆祝动画
                loveCard.classList.add('celebrate');
                setTimeout(() => loveCard.classList.remove('celebrate'), 700);

                // 同意按钮文字变化
                const originalText = yesBtn.innerHTML;
                yesBtn.innerHTML = '🥰 谢谢你！ 🥰';
                setTimeout(() => {
                    yesBtn.innerHTML = '💖 小硕头 💖';
                }, 1200);

                // 飘落爱心特效
                const emojis = ['❤️', '💕', '💖', '🌸', '✨', '🦋', '🌷', '💗', '🌟', '🎉', '🥰'];
                const count = window.innerWidth < 400 ? 18 : 28;
                for (let i = 0; i < count; i++) {
                    setTimeout(() => {
                        const heart = document.createElement('div');
                        heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                        heart.style.position = 'fixed';
                        heart.style.left = Math.random() * 100 + 'vw';
                        heart.style.top = '-10vh';
                        const size = (1.8 + Math.random() * 3.5) + 'rem';
                        heart.style.fontSize = size;
                        heart.style.zIndex = '999';
                        heart.style.pointerEvents = 'none';
                        heart.style.transition = 'all 3.2s cubic-bezier(0.1, 0.9, 0.2, 1)';
                        heart.style.opacity = '0.9';
                        heart.style.filter = 'drop-shadow(0 3px 10px rgba(255,80,130,0.35))';
                        document.body.appendChild(heart);
                        requestAnimationFrame(() => {
                            heart.style.transform = `translateY(${110 + Math.random() * 50}vh) rotate(${Math.random() * 80 - 40}deg)`;
                            heart.style.opacity = '0';
                        });
                        setTimeout(() => heart.remove(), 3800);
                    }, i * 70);
                }
            }

            // 同意按钮点击
            yesBtn.addEventListener('click', function(e) {
                if (isAccepted) return;
                e.preventDefault();
                fixPage();
            });

            // 触摸设备同样支持
            yesBtn.addEventListener('touchstart', function(e) {
                if (isAccepted) return;
                e.preventDefault();
                fixPage();
            }, { passive: false });

            // 初始化
            function init() {
                initNoButton();
                setTimeout(() => initNoButton(), 100);
                setTimeout(() => moveNoButtonFast(), 250);
            }

            window.addEventListener('load', init);

            // 窗口resize时重新调整（仅在未固定时）
            window.addEventListener('resize', function() {
                if (isAccepted) return;
                const currentLeft = parseFloat(noBtn.style.left) || 0;
                const currentTop = parseFloat(noBtn.style.top) || 0;
                const { maxX, maxY } = getMoveBounds();
                if (currentLeft > maxX) {
                    noBtn.style.left = Math.min(maxX, currentLeft) + 'px';
                }
                if (currentTop > maxY) {
                    noBtn.style.top = Math.min(maxY, currentTop) + 'px';
                }
                initNoButton();
            });

            // 自动移动（仅当未同意时）
            setInterval(() => {
                if (!isAccepted && Math.random() < 0.6) {
                    moveNoButtonFast();
                }
            }, 1800);

        })();
    </script>
</body>
</html>
